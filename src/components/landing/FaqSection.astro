---
import IconGlyph from './IconGlyph.astro';

interface FaqItem {
  q: string;
  a: string;
}

interface Props {
  faqs: FaqItem[];
  primaryCtaHref: string;
  primaryCtaLabel: string;
  ctaMicrocopy: string;
}

const { faqs, primaryCtaHref, primaryCtaLabel, ctaMicrocopy } = Astro.props;
---

<section id="faq" class="mx-auto max-w-[1240px] scroll-mt-28 px-4 py-14 md:px-6 md:py-18">
  <div class="grid gap-10 lg:grid-cols-[0.42fr_0.58fr] lg:items-start">
    <div class="lg:sticky lg:top-28">
      <div class="text-xs font-black uppercase tracking-[0.22em] text-[color:var(--brand)]">Preguntas frecuentes</div>
      <h2 class="mt-3 max-w-md text-3xl font-bold tracking-[-0.03em] text-[color:var(--ink)] md:text-5xl">
        Resuelve lo clave antes de empezar.
      </h2>
      <p class="mt-4 max-w-md text-[16px] leading-8 text-[color:var(--muted)]">
        {ctaMicrocopy}
      </p>
    </div>

    <div class="grid gap-3">
      {faqs.map((faq) => (
        <details class="group rounded-[1.5rem] border border-[color:var(--line)] bg-white p-5 shadow-[0_14px_30px_color-mix(in_srgb,var(--navy)_5.5%,transparent)]">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-base font-black text-[color:var(--ink)] marker:hidden">
            <span>{faq.q}</span>
            <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-[color:var(--page-bg-soft)] text-[color:var(--brand)] transition-transform group-open:rotate-45">+</span>
          </summary>
          <p class="mt-4 max-w-2xl text-sm leading-7 text-[color:var(--muted)]">{faq.a}</p>
        </details>
      ))}
    </div>
  </div>

  <div class="mt-12 overflow-hidden rounded-[2rem] bg-[color:var(--brand-strong)] p-6 text-white shadow-[0_26px_62px_color-mix(in_srgb,var(--navy)_20%,transparent)] md:p-10">
    <div class="grid gap-6 md:grid-cols-[1fr_auto] md:items-center">
      <div class="flex gap-5">
        <div class="hidden h-16 w-16 shrink-0 items-center justify-center rounded-2xl bg-[color-mix(in_srgb,var(--brand)_95%,transparent)] shadow-[0_20px_42px_color-mix(in_srgb,var(--brand)_28%,transparent)] sm:flex">
          <IconGlyph name="gift" class="h-7 w-7" />
        </div>
        <div>
          <h2 class="text-2xl font-bold tracking-[-0.025em] md:text-4xl">
            ¿Quieres conocer Nexuit antes de la apertura?
          </h2>
          <p class="mt-3 max-w-2xl text-sm leading-7 text-white md:text-base">
            Cuéntanos qué tipo de negocio tienes y te avisaremos cuando puedas acceder.
          </p>
        </div>
      </div>
      <div>
        <a
          href={primaryCtaHref}
          data-cta="final-early-access"
          class="inline-flex w-full justify-center rounded-2xl bg-white px-8 py-4 text-sm font-black text-[color:var(--brand)] shadow-[0_18px_40px_rgba(255,255,255,0.12)] transition-transform duration-200 hover:-translate-y-0.5 md:w-auto"
        >
          {primaryCtaLabel}
        </a>
        <div class="mt-3 text-center text-xs font-medium text-white">{ctaMicrocopy}</div>
      </div>
    </div>
  </div>
</section>
