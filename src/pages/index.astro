---
import EarlyAccessForm from '../components/landing/EarlyAccessForm.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqSection from '../components/landing/FaqSection.astro';
import HeroSection from '../components/landing/HeroSection.astro';
import LandingFooter from '../components/landing/LandingFooter.astro';
import LandingHeader from '../components/landing/LandingHeader.astro';
import ValueSections from '../components/landing/ValueSections.astro';

const PRIMARY_CTA_LABEL = 'Solicitar acceso anticipado';
const PRIMARY_CTA_HREF = '#acceso-anticipado';
const ctaMicrocopy = 'Déjanos tus datos y te avisaremos cuando abramos el acceso.';

const heroChips = [
  'Stock por sucursal',
  'Ventas conectadas',
  'Empaque validado',
  'Conciliación de inventario',
];

const problemCards = [
  {
    title: 'Stock descuadrado',
    desc: 'El sistema dice una cosa y el conteo físico otra.',
    icon: 'warning',
  },
  {
    title: 'Pedidos mal empacados',
    desc: 'Errores que generan devoluciones, reclamos y costos.',
    icon: 'box',
  },
  {
    title: 'Diferencias sin explicación',
    desc: 'No sabes si el faltante viene de venta, salida, ajuste o empaque.',
    icon: 'shield',
  },
] as const;

const operationSteps = [
  { title: 'Catálogo', desc: 'Productos y SKUs.', icon: 'catalog' },
  { title: 'Stock', desc: 'Existencias por ubicación.', icon: 'warehouse' },
  { title: 'Venta', desc: 'Descuenta inventario.', icon: 'movement' },
  { title: 'Organización', desc: 'Pedidos listos.', icon: 'layers' },
  { title: 'Empaque', desc: 'Validación final.', icon: 'box' },
  { title: 'Conciliación', desc: 'Explica diferencias.', icon: 'check' },
] as const;

const reconciliationRows = [
  { product: 'Playera negra', system: '120', physical: '116', diff: '-4', status: 'Revisar', tone: 'danger' },
  { product: 'Gorra bordada', system: '80', physical: '80', diff: '0', status: 'Cuadrado', tone: 'success' },
  { product: 'Banco de madera', system: '45', physical: '47', diff: '+2', status: 'Sobrante', tone: 'info' },
  { product: 'Camisa de trabajo', system: '30', physical: '28', diff: '-2', status: 'Revisar', tone: 'danger' },
  { product: 'Repisa de pino', system: '15', physical: '15', diff: '0', status: 'Cuadrado', tone: 'success' },
] as const;

const reconciliationBenefits = [
  { title: 'Conteos físicos por ubicación', icon: 'layers' },
  { title: 'Historial de movimientos', icon: 'movement' },
  { title: 'Ajustes controlados', icon: 'check' },
  { title: 'Trazabilidad operativa', icon: 'shield' },
] as const;

const deviceBullets = [
  {
    title: 'Desktop',
    desc: 'Reportes, configuración, catálogo, conciliaciones y más.',
    icon: 'desktop',
  },
  {
    title: 'Móvil',
    desc: 'Conteos, ventas, organización de pedidos, empaque y salidas en segundos.',
    icon: 'phone',
  },
] as const;

const packingItems = [
  { item: 'Playera Negra M', status: 'validado' },
  { item: 'Gorra Azul', status: 'validado' },
  { item: 'Tenis Blanco', status: 'validado' },
  { item: 'Mandil de lona', status: 'pendiente' },
] as const;

const audienceCards = [
  { title: 'Talleres textiles', desc: 'Controla playeras, uniformes y gorras por talla, color y modelo.', icon: 'layers' },
  { title: 'Carpinterías y mueblerías', desc: 'Organiza las piezas terminadas y los pedidos pendientes de entrega.', icon: 'box' },
  { title: 'Talleres de personalización', desc: 'Prepara y revisa pedidos de bordado, estampado o grabado antes de enviarlos.', icon: 'store' },
  { title: 'Pequeños fabricantes', desc: 'Consulta existencias por ubicación y concilia el conteo físico con tus movimientos.', icon: 'truck' },
] as const;

const faqs = [
  { q: '¿Qué pasa cuando solicito acceso anticipado?', a: 'Tu solicitud queda en la lista. Te contactaremos para informarte cuándo puedes acceder a Nexuit.' },
  { q: '¿Necesito proporcionar mi WhatsApp?', a: 'Es opcional. Puedes dejar tu correo como medio de contacto.' },
  { q: '¿Para qué tipo de negocio es Nexuit?', a: 'Está pensado para talleres y pequeños fabricantes que necesitan organizar su inventario, sus ventas y la preparación de pedidos.' },
];
---

<BaseLayout
  title="Nexuit | Acceso anticipado para talleres y pequeños fabricantes"
  description="Solicita acceso anticipado a Nexuit para organizar el inventario, las ventas y el empaque de tu taller o pequeña fábrica."
  path="/"
>
  <LandingHeader />
  <main>
    <HeroSection
      chips={heroChips}
      primaryCtaHref={PRIMARY_CTA_HREF}
      primaryCtaLabel={PRIMARY_CTA_LABEL}
      ctaMicrocopy={ctaMicrocopy}
    />
    <EarlyAccessForm />
    <ValueSections
      problemCards={problemCards}
      operationSteps={operationSteps}
      reconciliationRows={reconciliationRows}
      reconciliationBenefits={reconciliationBenefits}
      deviceBullets={deviceBullets}
      packingItems={packingItems}
      audienceCards={audienceCards}
    />
    <FaqSection
      faqs={faqs}
      primaryCtaHref={PRIMARY_CTA_HREF}
      primaryCtaLabel={PRIMARY_CTA_LABEL}
      ctaMicrocopy={ctaMicrocopy}
    />
  </main>
  <LandingFooter />
</BaseLayout>
