---
import BaseLayout from '../layouts/BaseLayout.astro';
import LandingHeader from '../components/landing/LandingHeader.astro';
import LandingFooter from '../components/landing/LandingFooter.astro';
---

<BaseLayout title="Página no encontrada | Nexuit" description="La página que buscas no está disponible." path="/404" noindex>
  <div class="flex min-h-screen flex-col">
    <LandingHeader />
    <main class="mx-auto grid w-full max-w-3xl flex-1 place-items-center px-4 py-16 text-center md:px-6">
      <div class="w-full rounded-[2rem] border border-[color:var(--line)] bg-white px-6 py-12 sm:px-10">
        <p class="font-bold tracking-[0.12em] text-[color:var(--brand)]">404</p>
        <h1 class="mt-3 text-3xl font-bold tracking-tight sm:text-5xl">Página no encontrada</h1>
        <p class="mx-auto mt-4 max-w-sm leading-7 text-[color:var(--muted)]">La dirección pudo haber cambiado. Puedes volver al inicio de Nexuit.</p>
        <a href="/" class="mt-7 inline-flex rounded-xl bg-[color:var(--brand)] px-5 py-3 text-sm font-bold text-white hover:bg-[color:var(--brand-strong)]">
          Volver al inicio
        </a>
      </div>
    </main>
    <LandingFooter />
  </div>
</BaseLayout>
